{
  "info": {
    "name": "AutonomIQ - Authentication and Authorization",
    "description": "Runnable learning collection for the AutonomIQ auth flow. Start the API on http://localhost:3001, run requests in order, and keep Postman's cookie jar enabled. The API uses a signed HTTP-only autonomiq_session cookie, not a bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "firstName", "value": "Ada" },
    { "key": "lastName", "value": "Tester" },
    { "key": "email", "value": "ada.tester{{$timestamp}}@example.com" },
    { "key": "password", "value": "Password123!" },
    { "key": "newPassword", "value": "NewPassword123!" },
    { "key": "userId", "value": "" },
    { "key": "orgId", "value": "" },
    { "key": "memberUserId", "value": "" },
    { "key": "sessionId", "value": "paste-session-id-from-list" },
    { "key": "apiKeyId", "value": "" },
    { "key": "apiKeyPlaintext", "value": "" },
    { "key": "projectId", "value": "replace-with-project-id" },
    { "key": "verificationToken", "value": "paste-token-from-email-or-database" },
    { "key": "verificationCode", "value": "000000" },
    { "key": "resetToken", "value": "paste-token-from-email-or-database" },
    { "key": "invitationToken", "value": "paste-token-from-response" },
    { "key": "totpCode", "value": "000000" }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirms the Express API is reachable before testing authentication."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('API is healthy', function () {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().ok).to.eql(true);", "});"] } }]
        }
      ]
    },
    {
      "name": "01 - AuthN: register and login",
      "description": "Run Register, then Login. Postman stores the signed HTTP-only cookie automatically; do not add an Authorization header.",
      "item": [
        {
          "name": "Register user and default organization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates User, UserSettings, Organization, and OWNER Membership, then sets autonomiq_session."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);", "if (body.verificationCode) pm.collectionVariables.set('verificationCode', body.verificationCode);", "pm.test('Session cookie was set', function () { pm.expect(pm.cookies.has('autonomiq_session')).to.eql(true); });"] } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login",
            "description": "Validates bcrypt password and replaces the Redis-backed session cookie."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);", "if (body.organizationId) pm.collectionVariables.set('orgId', body.organizationId);", "pm.test('Session cookie was set', function () { pm.expect(pm.cookies.has('autonomiq_session')).to.eql(true); });"] } }]
        },
        {
          "name": "Current user and organizations",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me", "description": "Reads the authenticated user from the signed cookie, then loads memberships and organizations." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Authenticated', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body.organizations && body.organizations.length) pm.collectionVariables.set('orgId', body.organizations[0].id);"] } }]
        },
        {
          "name": "Refresh session",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/refresh", "description": "Checks the current Redis session and extends its TTL. The cookie remains the session credential." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Session refreshed', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "List active sessions",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/me/sessions", "description": "Lists Redis sessions without exposing cookie tokens. Save a returned sessionId to revoke one device." }
        }
      ]
    },
    {
      "name": "02 - AuthN: password and email security",
      "description": "Password reset tokens and email verification tokens are intentionally not returned by production endpoints. Paste a token into the collection variables after connecting an email provider or inspecting local development data.",
      "item": [
        {
          "name": "Request password reset",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" }, "url": "{{baseUrl}}/auth/password-reset/request", "description": "Always returns the same message so callers cannot discover whether an email exists." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Generic reset response', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Reset password with token",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/password-reset", "description": "Consumes a non-expired reset token and changes the bcrypt password." }
        },
        {
          "name": "Change password while logged in",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/password/change", "description": "Requires the current signed session and current password." }
        },
        {
          "name": "Verify email",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}" }, "url": "{{baseUrl}}/auth/verify-email", "description": "Marks emailVerified true when the token is valid and unexpired." }
        },
        {
          "name": "Verify email with six-digit code",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{verificationCode}}\"\n}" }, "url": "{{baseUrl}}/auth/verify-email", "description": "Alternative to the link token. In development, Register saves the code into verificationCode automatically." }
        },
        {
          "name": "Simulate Google OAuth callback",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"providerAccountId\": \"google-test-account\",\n  \"email\": \"{{email}}\",\n  \"name\": \"{{firstName}} {{lastName}}\"\n}" }, "url": "{{baseUrl}}/auth/oauth/google", "description": "Development adapter for the OAuth service. A real Google authorization-code redirect/callback still needs provider credentials." }
        },
        {
          "name": "Simulate GitHub OAuth callback",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"providerAccountId\": \"github-test-account\",\n  \"email\": \"{{email}}\",\n  \"name\": \"{{firstName}} {{lastName}}\"\n}" }, "url": "{{baseUrl}}/auth/oauth/github", "description": "Development adapter for the OAuth service. A real GitHub authorization-code redirect/callback still needs provider credentials." }
        },
        {
          "name": "Delete account (run last for this user)",
          "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/auth/account", "description": "Soft-deletes the authenticated user. Run this only after all other requests for this test user." }
        },
        {
          "name": "Start Google browser OAuth",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/google", "description": "Redirects to Google when GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are configured. Send without following redirects to inspect the Location header." }
        },
        {
          "name": "Start GitHub browser OAuth",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/github", "description": "Redirects to GitHub when GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are configured." }
        }
      ]
    },
    {
      "name": "03 - User profile, settings, and 2FA",
      "item": [
        { "name": "Get profile", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/me/profile" } },
        { "name": "Update profile", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"avatarUrl\": null\n}" }, "url": "{{baseUrl}}/users/me/profile" } },
        { "name": "Update settings", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"timezone\": \"UTC\",\n  \"emailNotifications\": true,\n  \"slackNotifications\": false\n}" }, "url": "{{baseUrl}}/users/me/settings" } },
        { "name": "Enable 2FA and receive QR data URL", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/users/me/enable-2fa", "description": "Stores a pending TOTP secret and returns a QR data URL. Scan it, then put the six-digit code in totpCode." } },
        { "name": "Verify and enable 2FA", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"totpCode\": \"{{totpCode}}\"\n}" }, "url": "{{baseUrl}}/users/me/verify-2fa" } },
        { "name": "Revoke one session", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/users/me/sessions/{{sessionId}}", "description": "Revokes one Redis session by its opaque sessionId." } },
        { "name": "Revoke other sessions", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/users/me/sessions", "description": "Keeps the current cookie session and removes all other Redis sessions." } }
      ]
    },
    {
      "name": "04 - API keys and encrypted test credentials",
      "description": "API keys are shown once. Test credential passwords are encrypted with AES-256-GCM and never returned.",
      "item": [
        {
          "name": "Create API key",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"local test runner\",\n  \"permissions\": [\"test:run\", \"view:reports\"]\n}" }, "url": "{{baseUrl}}/api-keys", "description": "Requires an active organization in the session. Save the returned plaintext key immediately." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('API key created', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "if (body.apiKey && body.apiKey.id) pm.collectionVariables.set('apiKeyId', body.apiKey.id);", "if (body.key) pm.collectionVariables.set('apiKeyPlaintext', body.key);"] } }]
        },
        { "name": "List API keys", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api-keys", "description": "Returns metadata only; plaintext keys cannot be recovered." } },
        { "name": "Queue test run with API key", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-api-key", "value": "{{apiKeyPlaintext}}" }], "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\"\n}" }, "url": "{{baseUrl}}/tests/run", "description": "Uses x-api-key authentication and requires the test:run permission. Returns HTTP 202 with a queued TestRun." } },
        { "name": "Create encrypted test credential", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin User\",\n  \"username\": \"admin@example.com\",\n  \"password\": \"bot-password-never-returned\",\n  \"role\": \"admin\",\n  \"environment\": \"DEVELOPMENT\"\n}" }, "url": "{{baseUrl}}/projects/{{projectId}}/test-credentials" } },
        { "name": "Revoke API key", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api-keys/{{apiKeyId}}" } }
      ]
    },
    {
      "name": "05 - Organization RBAC",
      "description": "The active organization is carried in the Redis session. Organization routes additionally check membership and role permissions.",
      "item": [
        { "name": "List my organizations", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/organizations" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Organizations loaded', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "if (body[0]) pm.collectionVariables.set('orgId', body[0].id);"] } }] },
        { "name": "Create organization", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Secondary QA Organization\"\n}" }, "url": "{{baseUrl}}/organizations", "description": "Creates another organization and makes the authenticated user its OWNER." } },
        { "name": "Get organization", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/organizations/{{orgId}}" } },
        { "name": "List organization members", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/organizations/{{orgId}}/members" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body[0] && body[0].user) pm.collectionVariables.set('memberUserId', body[0].user.id);"] } }] },
        { "name": "Update organization", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ada's QA Organization\"\n}" }, "url": "{{baseUrl}}/organizations/{{orgId}}" } },
        { "name": "Invite member", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"teammate@example.com\",\n  \"role\": \"TESTER\"\n}" }, "url": "{{baseUrl}}/organizations/{{orgId}}/members/invite", "description": "Creates a 24-hour invitation and an audit log. In production, email the tokenized invite link." } },
        { "name": "Change member role", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"role\": \"DEVELOPER\"\n}" }, "url": "{{baseUrl}}/organizations/{{orgId}}/members/{{memberUserId}}", "description": "Requires OWNER or ADMIN and creates a ROLE_CHANGE audit log." } },
        { "name": "Accept invitation", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}" }, "url": "{{baseUrl}}/organizations/accept-invite" } },
        { "name": "Switch active organization", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/orgs/switch/{{orgId}}", "description": "Updates the active orgId and role inside the current Redis session cookie." } },
        { "name": "Remove member", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/organizations/{{orgId}}/members/{{memberUserId}}" } },
        { "name": "Delete organization (run last for this organization)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/organizations/{{orgId}}", "description": "Soft-deletes the organization, archives projects, and revokes its API keys. Requires OWNER." } }
      ]
    },
    {
      "name": "06 - Session end",
      "item": [
        { "name": "Logout", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/logout", "description": "Deletes the Redis session and clears the signed cookie. Run this last because later requests will return 401." }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logged out', function () { pm.response.to.have.status(200); });"] } }] },
        { "name": "Verify protected route is blocked", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me", "description": "Run after Logout to see the expected 401 response." }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Protected route rejects logged-out request', function () { pm.response.to.have.status(401); });"] } }] }
      ]
    },
    {
      "name": "07 - Projects and applications",
      "description": "These requests cover the remaining current API routes. Set organizationId and projectId from the previous responses before running them.",
      "item": [
        {
          "name": "List projects for organization",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/projects/{{orgId}}", "description": "Lists projects belonging to the selected organization." }
        },
        {
          "name": "Create project",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Authentication QA\",\n  \"description\": \"Project created from Postman\",\n  \"organizationId\": \"{{orgId}}\"\n}" }, "url": "{{baseUrl}}/projects", "description": "Creates a project in the selected organization." },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.id) pm.collectionVariables.set('projectId', body.id);"] } }]
        },
        {
          "name": "List applications for project",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/applications/{{projectId}}", "description": "Lists applications attached to the selected project." }
        },
        {
          "name": "Create application",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"AutonomIQ Web\",\n  \"url\": \"https://example.com\",\n  \"description\": \"Application created from Postman\",\n  \"projectId\": \"{{projectId}}\"\n}" }, "url": "{{baseUrl}}/applications", "description": "Creates an application in the selected project." }
        }
      ]
    }
  ]
}
